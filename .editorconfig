root = true

[*.cs]

# ----------------------------------------------------------------------
# Code style
# ----------------------------------------------------------------------

# Prefer explicit qualification for instance fields, properties, and events
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_property = true:suggestion
dotnet_style_qualification_for_event = true:suggestion
dotnet_style_qualification_for_method = false:none

resharper_csharp_instance_members_qualify_members = field, property, event
resharper_arrange_this_qualifier_highlighting = suggestion

# Prefer explicit type names over var
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = false:silent
csharp_style_var_elsewhere = false:silent

resharper_csharp_for_built_in_types = use_explicit_type
resharper_suggest_var_or_type_built_in_types_highlighting = hint
resharper_csharp_for_simple_types = use_explicit_type
resharper_suggest_var_or_type_simple_types_highlighting = hint
resharper_csharp_for_other_types = use_explicit_type
resharper_suggest_var_or_type_elsewhere_highlighting = hint

# Prefer target-typed object creation when the target type is apparent
csharp_object_creation_when_type_evident = target_typed

resharper_csharp_object_creation_when_type_evident = target_typed
resharper_arrange_object_creation_when_type_evident_highlighting = suggestion

# Always use explicit access modifiers
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

resharper_csharp_default_private_modifier = explicit
resharper_csharp_default_internal_modifier = explicit

# Put braces on the next line
csharp_new_line_before_open_brace = all

resharper_csharp_brace_style = next_line

# Always use braces when a statement is multiline
csharp_prefer_braces = when_multiline:suggestion

resharper_csharp_braces_for_ifelse = required_for_multiline_statement
resharper_csharp_braces_for_for = required_for_multiline_statement
resharper_csharp_braces_for_foreach = required_for_multiline_statement
resharper_csharp_braces_for_while = required_for_multiline_statement
resharper_csharp_braces_for_lock = required_for_multiline_statement
resharper_csharp_braces_for_using = required_for_multiline_statement

# Prefer keywords for builtin types
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

resharper_csharp_builtin_type_reference_style = use_keyword
resharper_csharp_builtin_type_reference_for_member_access_style = use_keyword

# Only keep one empty line within the code
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_keep_blank_lines_in_declarations = 1

# Prefer string.Empty over ""
resharper_empty_string = string_empty
resharper_arrange_empty_string_highlighting = suggestion

# Empty lines between properties
resharper_csharp_blank_lines_around_property = 1

# Prefer 'is' for comparisons
csharp_style_prefer_pattern_matching = true:suggestion

# Indentation
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

resharper_csharp_indent_style = space
resharper_csharp_indent_size = 4
resharper_csharp_tab_width = 4

# ----------------------------------------------------------------------
# Naming styles
# ----------------------------------------------------------------------

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.ipascal_case.capitalization = pascal_case
dotnet_naming_style.ipascal_case.required_prefix = I

dotnet_naming_style.tpascal_case.capitalization = pascal_case
dotnet_naming_style.tpascal_case.required_prefix = T

dotnet_naming_style.all_upper.capitalization = all_upper
dotnet_naming_style.all_upper.word_separator = _

# ----------------------------------------------------------------------
# Naming rules
# ----------------------------------------------------------------------

# Instance fields: camelCase
dotnet_naming_rule.instance_fields_camel_case.severity = suggestion
dotnet_naming_rule.instance_fields_camel_case.symbols = instance_fields
dotnet_naming_rule.instance_fields_camel_case.style = camel_case

dotnet_naming_symbols.instance_fields.applicable_kinds = field

# Properties: PascalCase
dotnet_naming_rule.properties_pascal_case.severity = suggestion
dotnet_naming_rule.properties_pascal_case.symbols = properties
dotnet_naming_rule.properties_pascal_case.style = pascal_case

dotnet_naming_symbols.properties.applicable_kinds = property

# Static fields: PascalCase
dotnet_naming_rule.static_fields_pascal_case.severity = suggestion
dotnet_naming_rule.static_fields_pascal_case.symbols = static_fields
dotnet_naming_rule.static_fields_pascal_case.style = pascal_case

dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static

# Constants: ALL_UPPER
dotnet_naming_rule.constants_all_upper.severity = suggestion
dotnet_naming_rule.constants_all_upper.symbols = constants
dotnet_naming_rule.constants_all_upper.style = all_upper

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

# Types: PascalCase
dotnet_naming_rule.types_pascal_case.severity = suggestion
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, namespace

# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_ipascal_case.severity = suggestion
dotnet_naming_rule.interfaces_ipascal_case.symbols = interfaces
dotnet_naming_rule.interfaces_ipascal_case.style = ipascal_case

dotnet_naming_symbols.interfaces.applicable_kinds = interface

# Type parameters: TPascalCase
dotnet_naming_rule.type_parameters_tpascal_case.severity = suggestion
dotnet_naming_rule.type_parameters_tpascal_case.symbols = type_parameters
dotnet_naming_rule.type_parameters_tpascal_case.style = tpascal_case

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

# Warnings
dotnet_diagnostic.CA1859.severity = none
