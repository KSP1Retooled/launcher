<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:app="using:KSP.Retooled.Launcher.App"
  xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
  x:Class="KSP.Retooled.Launcher.App.MainWindow"
  x:DataType="app:MainViewModel"
  Title="{Binding Title}"
  Width="900"
  Height="640"
  MinWidth="680"
  MinHeight="480"
  WindowStartupLocation="CenterScreen"
>
  <Window.Resources>
    <StreamGeometry x:Key="GearIcon">M19.58,10.18 L22.41,10.60 L22.41,13.40 L19.58,13.82 L18.65,16.08 L20.35,18.37 L18.37,20.35 L16.08,18.65 L13.82,19.58 L13.40,22.41 L10.60,22.41 L10.18,19.58 L7.92,18.65 L5.63,20.35 L3.65,18.37 L5.35,16.08 L4.42,13.82 L1.59,13.40 L1.59,10.60 L4.42,10.18 L5.35,7.92 L3.65,5.63 L5.63,3.65 L7.92,5.35 L10.18,4.42 L10.60,1.59 L13.40,1.59 L13.82,4.42 L16.08,5.35 L18.37,3.65 L20.35,5.63 L18.65,7.92 Z M15.40,12 A3.4,3.4 0 1 0 8.60,12 A3.4,3.4 0 1 0 15.40,12 Z</StreamGeometry>
  </Window.Resources>

  <DockPanel Margin="16">
    <!-- install folder -->
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="KSP install" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button
          Grid.Column="1"
          Command="{Binding OpenSettingsCommand}"
          ToolTip.Tip="Settings"
          AutomationProperties.Name="Settings"
          Padding="6"
        >
          <PathIcon Width="16" Height="16" Data="{StaticResource GearIcon}" />
        </Button>
      </Grid>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox
          Grid.Column="0"
          Text="{Binding InstallPath}"
          PlaceholderText="Folder with GameData and the game (KSP 1.12.5)"
        />
        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
        <Button Grid.Column="2" Content="Find installs" Command="{Binding DetectCommand}" />
      </Grid>
      <ComboBox
        ItemsSource="{Binding DetectedInstalls}"
        SelectedItem="{Binding InstallPath}"
        HorizontalAlignment="Stretch"
        PlaceholderText="Installs found on this computer"
        IsVisible="{Binding HasDetectedInstalls}"
      />
      <TextBlock Text="{Binding InstallState}" TextWrapping="Wrap" />
      <TextBlock
        Text="{Binding UpdateNotice}"
        Foreground="{DynamicResource SystemAccentColor}"
        FontWeight="SemiBold"
        IsVisible="{Binding UpdateNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
      />
    </StackPanel>

    <!-- actions and progress -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsBusy}" ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Activity}" />
          <ProgressBar
            Minimum="0"
            Maximum="100"
            Value="{Binding ProgressValue}"
            IsIndeterminate="{Binding ProgressIndeterminate}"
          />
        </StackPanel>
        <Button
          Grid.Column="1"
          Content="Cancel"
          VerticalAlignment="Bottom"
          Command="{Binding CancelCommand}"
        />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <!-- in this row, not floating over it, so that it cannot cover a button in a narrow window -->
        <Border
          Classes="toast"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          IsVisible="{Binding LauncherUpdateNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
        >
          <WrapPanel ItemSpacing="8" LineSpacing="4">
            <TextBlock
              Text="{Binding LauncherUpdateNotice}"
              TextWrapping="Wrap"
              VerticalAlignment="Center"
            />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button
                Content="Download"
                Command="{Binding OpenLauncherUpdateCommand}"
                IsVisible="{Binding HasLauncherUpdate}"
              />
              <Button
                Content="Restart"
                Command="{Binding RestartLauncherCommand}"
                IsVisible="{Binding HasDownloadedLauncher}"
              />
              <Button
                Content="✕"
                ToolTip.Tip="Dismiss"
                Command="{Binding DismissLauncherUpdateCommand}"
              />
            </StackPanel>
          </WrapPanel>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Install patch file…" Command="{Binding InstallFileCommand}" />
          <Button Content="Uninstall" Command="{Binding UninstallCommand}" />
          <Button
            Content="{Binding ActionLabel}"
            Command="{Binding InstallSelectedCommand}"
            Classes="accent"
          />
          <Button
            Content="Play"
            Command="{Binding PlayCommand}"
            ToolTip.Tip="{Binding PlayTip}"
            ToolTip.ShowOnDisabled="True"
            Classes="accent"
            MinWidth="90"
            HorizontalContentAlignment="Center"
          />
        </StackPanel>
      </Grid>
    </StackPanel>

    <!-- log -->
    <Expander DockPanel.Dock="Bottom" Header="Log" Margin="0,12,0,0" HorizontalAlignment="Stretch">
      <TextBox
        Text="{Binding Log}"
        IsReadOnly="True"
        Height="140"
        FontFamily="{DynamicResource ContentControlThemeFontFamily}"
        TextWrapping="Wrap"
        CaretIndex="{Binding Log.Length, Mode=OneWay}"
      />
    </Expander>

    <!-- releases -->
    <Grid
      RowDefinitions="Auto,Auto,Auto,*"
      ColumnDefinitions="3*,2*"
      ColumnSpacing="12"
      Margin="0,16,0,0"
    >
      <Grid
        Grid.Row="0"
        Grid.ColumnSpan="2"
        ColumnDefinitions="Auto,*,Auto,Auto"
        ColumnSpacing="8"
        Margin="0,0,0,8"
      >
        <TextBlock Text="Channel" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ComboBox
          Grid.Column="1"
          ItemsSource="{Binding Channels}"
          SelectedItem="{Binding Channel}"
          IsEnabled="{Binding !IsBusy}"
          HorizontalAlignment="Stretch"
        />
        <Button Grid.Column="2" Content="Add…" Command="{Binding AddChannelCommand}" />
        <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveChannelCommand}" />
      </Grid>
      <Grid
        Grid.Row="1"
        Grid.ColumnSpan="2"
        ColumnDefinitions="Auto,*,Auto,Auto"
        ColumnSpacing="8"
        Margin="0,0,0,6"
      >
        <TextBlock Text="Releases" FontWeight="SemiBold" VerticalAlignment="Center" />
        <CheckBox
          Grid.Column="2"
          Content="Show pre-releases"
          IsChecked="{Binding IncludePrereleases}"
        />
        <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" />
      </Grid>
      <TextBlock
        Grid.Row="2"
        Grid.ColumnSpan="2"
        Text="{Binding ReleaseError}"
        TextWrapping="Wrap"
        Foreground="OrangeRed"
        IsVisible="{Binding HasReleaseError}"
        Margin="0,0,0,6"
      />

      <TextBlock
        Grid.Row="3"
        Grid.ColumnSpan="2"
        Text="No releases to show."
        Opacity="0.6"
        Margin="0,8,0,0"
        IsVisible="{Binding !HasReleases}"
      />

      <ListBox
        Grid.Row="3"
        Grid.Column="0"
        ItemsSource="{Binding Releases}"
        SelectedItem="{Binding SelectedRelease}"
        IsVisible="{Binding HasReleases}"
        Background="Transparent"
        BorderThickness="1"
        CornerRadius="4"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
      >
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="app:ReleaseItem">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Border Classes="badge" IsVisible="{Binding IsInstalled}">
                  <TextBlock Text="installed" />
                </Border>
                <Border Classes="badge" IsVisible="{Binding IsLatest}">
                  <TextBlock Text="latest" />
                </Border>
                <Border Classes="badge pre" IsVisible="{Binding IsPrerelease}">
                  <TextBlock Text="pre-release" />
                </Border>
                <Border Classes="badge none" IsVisible="{Binding NoBuild}">
                  <TextBlock Text="no build for this OS" />
                </Border>
              </StackPanel>
              <TextBlock
                Grid.Column="1"
                Text="{Binding Date}"
                Opacity="0.6"
                VerticalAlignment="Center"
              />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <md:MarkdownScrollViewer
        x:Name="NotesView"
        Grid.Row="3"
        Grid.Column="1"
        IsVisible="{Binding HasReleases}"
        Markdown="{Binding Notes}"
        SelectionEnabled="True"
      />
    </Grid>
  </DockPanel>

  <Window.Styles>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.badge.pre">
      <Setter Property="Background" Value="DarkOrange" />
    </Style>
    <Style Selector="Border.badge.none">
      <Setter Property="Background" Value="Gray" />
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6,6,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </Window.Styles>
</Window>
